# GapBurn — keep source, docs, lockfiles, and .env.example.
# Clone, then: cd client && npm install && npm run dev

# Dependencies (reinstall with npm install)
node_modules/

# Build / cache
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo

# Local env (copy client/.env.example → client/.env)
.env
.env.*
!.env.example
!.env.*.example

# Logs and debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage
coverage/
.nyc_output/

# OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editors / IDEs
.idea/
.vscode/*
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# Cursor / local agent
.cursor/
.agent/

# Optional local Vite overrides
*.local
